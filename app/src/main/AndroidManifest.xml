<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application
        android:name=".VdvoemApplication"
        android:allowBackup="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vdvoem">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Vdvoem.Splash"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".update.InstallResultReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.vdvoem.INSTALL_RESULT" />
            </intent-filter>
        </receiver>

        <!-- Системный виджет «Цикл» (Glance): день, фаза, прогноз. -->
        <receiver
            android:name=".widget.CycleWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_cycle_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cycle_widget_info" />
        </receiver>

        <!-- Системный виджет «Календарь»: ближайшие события пары. -->
        <receiver
            android:name=".widget.CalendarWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_calendar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/calendar_widget_info" />
        </receiver>

        <!-- Системный виджет «Желание дня»: одно желание из общего списка. -->
        <receiver
            android:name=".widget.WishWidgetReceiver"
            android:exported="false"
            android:label="@string/widget_wish_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/wish_widget_info" />
        </receiver>

        <!-- Мгновенный пуш партнёру: WebSocket + постоянное уведомление (CYCLE_SPEC.md §8).
             specialUse — у dataSync на Android 15 есть лимит в 6 часов, после которого
             система гасит сервис; постоянному соединению такой лимит не подходит. -->
        <service
            android:name=".push.PushService"
            android:exported="false"
            android:foregroundServiceType="dataSync|specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Постоянное соединение с сервером пары для мгновенной доставки уведомлений" />
        </service>

        <!-- Поднимает пуш обратно после перезагрузки телефона и обновления приложения. -->
        <receiver
            android:name=".push.PushRestartReceiver"
            android:exported="true"
            android:directBootAware="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Будильник после свайпа из «недавних»: отправляем только мы, снаружи закрыт. -->
        <receiver
            android:name=".push.PushAlarmReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="app.vdvoem.push.RESTART" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
