    <string-array name="cycle_tips_period">
        <item>Warmth and rest</item>
        <item>More iron</item>
        <item>Gentle movement</item>
    </string-array>

    <string-array name="cycle_tips_period_text">
        <item>A heating pad and warm tea relax the muscles and ease cramps.</item>
        <item>Buckwheat, liver, pomegranate and greens support you on days of blood loss.</item>
        <item>A walk or stretching eases the pain better than complete rest.</item>
    </string-array>

    <string-array name="cycle_tips_follicular">
        <item>Energy is growing</item>
        <item>More protein</item>
        <item>Plans for two</item>
    </string-array>

    <string-array name="cycle_tips_follicular_text">
        <item>The first half of the cycle is the best time for new things and workouts.</item>
        <item>Protein and vegetables help you recover after the period.</item>
        <item>Agree on a weekend together while you have the most energy.</item>
    </string-array>

    <string-array name="cycle_tips_ovulation">
        <item>Peak energy</item>
        <item>Water and fibre</item>
        <item>More warmth</item>
    </string-array>

    <string-array name="cycle_tips_ovulation_text">
        <item>Ovulation often matches your energy peak — use it.</item>
        <item>It means less swelling and easier digestion.</item>
        <item>Hug more: closeness feels especially good on these days.</item>
    </string-array>

    <string-array name="cycle_tips_luteal">
        <item>Magnesium and sleep</item>
        <item>Be kind to yourself</item>
        <item>Less salt</item>
    </string-array>

    <string-array name="cycle_tips_luteal_text">
        <item>Nuts and greens plus eight hours of sleep smooth out mood swings.</item>
        <item>PMS is hormones, not character. Slow down without guilt.</item>
        <item>Salt holds water — that is where swelling and heaviness come from.</item>
    </string-array>
